# =============================================================================
# Alerta Córrego - configuração central da infraestrutura
# Todos os scripts leem este arquivo. Para adaptar a outra VM, altere só aqui.
# =============================================================================

# --- Identidade do servidor ---------------------------------------------------
SERVER_HOSTNAME="alerta-corrego-srv01"
DOMAIN="alertacorrego.local"
TIMEZONE="America/Sao_Paulo"

# --- Rede ---------------------------------------------------------------------
# A VM é de nuvem (IP público via DHCP). NÃO trocamos o IP da interface
# principal para não perder o acesso SSH. Criamos uma rede interna própria da
# aplicação numa interface dummy com IP estático, e a app escuta só nela.
PRIMARY_IFACE=""                 # vazio = detecta automaticamente pela rota default
INTERNAL_IFACE="citz0"
INTERNAL_IP="10.50.0.10"
INTERNAL_CIDR="24"
APP_INTERNAL_HOST="app.${DOMAIN}"

# DNS: servidores públicos usados pelo systemd-resolved (Cloudflare + Google)
DNS_SERVERS="1.1.1.1 8.8.8.8"
DNS_FALLBACK="9.9.9.9"

# Firewall: portas liberadas para fora
FIREWALL_ALLOW_PORTS="22/tcp 80/tcp"

# --- Aplicação ----------------------------------------------------------------
APP_NAME="alerta-corrego"
APP_USER="citizentech"
APP_DIR="/opt/citizentech/alerta-corrego"
APP_DATA_DIR="/var/lib/alerta-corrego"
APP_PORT="8000"
APP_WORKERS="2"

# Integração com o ESP32 do Wokwi (Physical Computing) via MQTT público
MQTT_BROKER="broker.hivemq.com"
MQTT_PORT="1883"
MQTT_TOPIC="citizentech/alerta-corrego/+/leituras"

# --- Monitoramento ------------------------------------------------------------
MONITOR_INTERVAL="15"            # segundos entre coletas
CPU_LIMIT="80"                   # % de uso
MEM_LIMIT="80"                   # % de uso
DISK_LIMIT="85"                  # % de uso da partição /
DISK_PATH="/"
ALERT_COOLDOWN="120"             # segundos sem repetir o mesmo alerta

# --- Logs ---------------------------------------------------------------------
LOG_DIR="/var/log/citizentech"
STATE_DIR="/var/lib/citizentech"
INSTALL_DIR="/opt/citizentech"
